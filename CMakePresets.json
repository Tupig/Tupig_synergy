{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vendor/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets/overlay"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC x64",
      "description": "Static-linked build for Windows (x64, Visual Studio 17 2022)",
      "inherits": "vcpkg-base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC x64 Release",
      "description": "Static-linked Release build for Windows (x64). Release is the only supported configuration: vcpkg dependencies are built Release-only. SYNERGY_VERSION_RELEASE makes the version X.Y.Z, so the GUI file is synergy_<X.Y.Z>.exe.",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYNERGY_VERSION_RELEASE": "ON"
      }
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows MSVC x64 + AddressSanitizer",
      "description": "AddressSanitizer build for memory-error hunting. Uses the dynamic-CRT triplet (x64-windows) because MSVC ASan requires /MD and therefore cannot use the static release triplet.",
      "inherits": "vcpkg-base",
      "binaryDir": "${sourceDir}/build-asan",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "SYNERGY_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "windows-msvc-2026",
      "displayName": "Windows MSVC x64 (Visual Studio 2026)",
      "description": "Same static triplet as windows-msvc, generated for Visual Studio 18 2026. scripts/build.bat selects this when vswhere -latest is VS 2026, so vcpkg and the app use one compiler. The STL symbols in a VS 2026 static Qt do not link with the VS 2022 toolset.",
      "inherits": "vcpkg-base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "windows-msvc-2026-release",
      "displayName": "Windows MSVC x64 Release (Visual Studio 2026)",
      "description": "Release build for Visual Studio 2026. Same version and triplet rules as windows-msvc-release.",
      "inherits": "windows-msvc-2026",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYNERGY_VERSION_RELEASE": "ON"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC x64 Debug",
      "description": "Debug build type for MSVC. NOTE: vcpkg dependencies are built Release-only (see triplets/overlay), so a Debug build cannot link them; build the Release configuration instead.",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux x64",
      "description": "Static-linked build for Linux (x64, Ninja)",
      "inherits": "vcpkg-base",
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64 Release",
      "description": "Static-linked Release build for Linux (x64). SYNERGY_VERSION_RELEASE makes the version X.Y.Z.",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYNERGY_VERSION_RELEASE": "ON"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS ARM64",
      "description": "Static-linked build for macOS (ARM64, Ninja)",
      "inherits": "vcpkg-base",
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS ARM64 Release",
      "description": "Static-linked Release build for macOS (ARM64). SYNERGY_VERSION_RELEASE makes the version X.Y.Z. Intel x86_64 is the CI job macos-x64, not this preset.",
      "inherits": "macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYNERGY_VERSION_RELEASE": "ON"
      }
    },
    {
      "name": "linux-asan",
      "inherits": "linux",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-linux-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SYNERGY_ENABLE_ASAN": "ON",
        "SYNERGY_ENABLE_AVX2": "OFF"
      }
    },
    {
      "name": "linux-tsan",
      "inherits": "linux",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-linux-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SYNERGY_ENABLE_LTO": "OFF",
        "SYNERGY_ENABLE_AVX2": "OFF",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -O1",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -O1",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "linux-coverage",
      "inherits": "linux",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-linux-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SYNERGY_ENABLE_LTO": "OFF",
        "CMAKE_C_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
        "CMAKE_CXX_FLAGS": "--coverage -fprofile-arcs -ftest-coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "linux-asan-build",
      "inherits": "linux-asan",
      "displayName": "Linux RelWithDebInfo + ASan",
      "description": "AddressSanitizer build (-O1) for memory error detection"
    },
    {
      "name": "linux-tsan-build",
      "inherits": "linux-tsan",
      "displayName": "Linux RelWithDebInfo + TSan",
      "description": "ThreadSanitizer build (-O1) for data race detection"
    },
    {
      "name": "linux-coverage-build",
      "inherits": "linux-coverage",
      "displayName": "Linux RelWithDebInfo + Coverage",
      "description": "Code coverage build for test coverage analysis"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-2026-release",
      "configurePreset": "windows-msvc-2026-release",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-asan",
      "configurePreset": "windows-msvc-asan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "linux-asan-build",
      "configurePreset": "linux-asan-build"
    },
    {
      "name": "linux-tsan-build",
      "configurePreset": "linux-tsan-build"
    },
    {
      "name": "linux-coverage-build",
      "configurePreset": "linux-coverage-build"
    }
  ]
}
