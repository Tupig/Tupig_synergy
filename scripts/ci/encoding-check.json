{
  "roots": ["src", "cmake", "scripts", "deploy", ".github", "translations"],
  "extensions": [
    ".c", ".cc", ".cpp", ".cxx", ".h", ".hpp", ".hxx", ".inl",
    ".m", ".mm", ".ui", ".qrc", ".rc", ".ts", ".qml",
    ".cmake", ".in", ".py", ".bat", ".sh",
    ".yml", ".yaml", ".json", ".xml", ".plist", ".desktop", ".service"
  ],
  "names": ["CMakeLists.txt"],
  "allowed": ["utf-8"],
  "exclude_dirs": ["vendor", "build", ".git", "dist", "node_modules", "downloads", "vcpkg_installed"]
}
