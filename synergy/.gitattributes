#auto handle line feed
* text=auto eol=lf

.gitattributes export-ignore
.gitignore export-ignore
.github* export-ignore

# vcpkg 预编译二进制包 (Git LFS)
deps/vcpkg-cache/**/*.dll filter=lfs diff=lfs merge=lfs -text
