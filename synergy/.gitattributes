deps/vcpkg-cache/**/*.exe filter=lfs diff=lfs merge=lfs -text
deps/vcpkg-cache/**/*.so filter=lfs diff=lfs merge=lfs -text
deps/vcpkg-cache/**/*.so.* filter=lfs diff=lfs merge=lfs -text
deps/vcpkg-cache/**/*.a filter=lfs diff=lfs merge=lfs -text
deps/vcpkg-cache/**/*.dylib filter=lfs diff=lfs merge=lfs -text
deps/vcpkg-cache/**/*.o filter=lfs diff=lfs merge=lfs -text
deps/vcpkg-cache/**/*.h filter=lfs diff=lfs merge=lfs -text
deps/vcpkg-cache/**/*.hpp filter=lfs diff=lfs merge=lfs -text
deps/vcpkg-cache/**/*.cmake filter=lfs diff=lfs merge=lfs -text
deps/vcpkg-cache/**/share/** filter=lfs diff=lfs merge=lfs -text
deps/vcpkg-cache/**/include/** filter=lfs diff=lfs merge=lfs -text
