{
  "mcpServers": {
    "system-info": {
      "command": "uvx",
      "args": ["mcp-system-info"],
      "env": {
        "SYSINFO_TRANSPORT": "stdio",
        "SYSINFO_CACHE_TTL": "10",
        "SYSINFO_LOG_LEVEL": "INFO"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "~/.config/TuPig Synergy"
      ]
    },
    "security-scan": {
      "command": "npx",
      "args": ["-y", "mcp-security-scan"],
      "env": {
        "MCP_SECURITY_SCAN_CONFIG": "~/.config/mcp-security-scan/config.json"
      }
    }
  }
}
